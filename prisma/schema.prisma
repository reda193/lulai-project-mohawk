generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  userId        String    @unique @default(cuid())
  first_name    String?
  last_name     String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  role          Role      @default(MEMBER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  verified      Boolean   @default(false)
  attempts      Int       @default(0)
  lastLogin     DateTime?
  accounts      Account[]
  sessions      Session[]
  bots          Bot[]     // New relation to bots
}

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Bot {
  id                   String    @id @default(cuid())
  bot_name             String
  description          String?   @db.Text
  purpose              String?   @db.Text
  company_size         String?
  company_type         String?
  use_case_category    String?
  use_case_description String?   @db.Text
  target_audience      String?
  privacy_level        String?
  model_type           BotModel  @default(GPT_3_5_TURBO)
  created_at           DateTime  @default(now())
  creator_id           String 
  creator              User      @relation(fields: [creator_id], references: [userId])

  appearance  Bot_Appearance[]
  @@index([creator_id])
}

model Bot_Appearance {
  id                   Int     @id @default(autoincrement())
  bot_id               String  @unique
  bot                 Bot     @relation(fields: [bot_id], references: [id], onDelete: Cascade)
  company_logo       String?  // URL or file path to the company logo
  bot_avatar         String?  // URL or file path to the bot's avatar
  accent_color       String?  // Hex code for UI accent color
  widget_icon        String?  // URL or file path to the widget icon
  widget_position    String?  // "bottom-right", "bottom-left", "top-right", "top-left", etc.
  input_placeholder  String?  // Placeholder text for user input
  branding_enabled   Boolean  @default(true) // Show/hide branding
  widget_open_by_default Boolean @default(false) // Whether the widget starts open
  starter_questions    Boolean?  @default(true)

  @@index([bot_id])
}


enum Role {
  ADMIN
  MEMBER
}

enum BotModel {
  GPT_3_5_TURBO
  GPT_4
  CLAUDE_3_OPUS
  CLAUDE_3_SONNET
  CLAUDE_3_HAIKU
  GEMINI_PRO
}